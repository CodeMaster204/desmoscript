raw{
    x^3 - 2x + 2 x  x x x $$(col1, 0.5, , dots);
    f(x) = x^2 $(green, , 1, dashes);
    x^7 $$;
    t= 2,2 $(green);
    col1 = rgb(0,0,0);
    p0 = -1,0 $(col1, 0.5, 10, star, no, no); # Color, opacity, thickness, shape, draggable, outline, label, anchor for label,
    (no,no^2) $(orange, 1, 15, triangle, xy);
    no = 0;
    p1 = 0,1 $(rgb(101,10,1),, 20, ,x, y);
star = 2;
    p2 = 1,0; $(orange);
    polygon(p0,p1,p2); $(orange, 0.5, 0.1, 2, dots, lines); 
    p3 = 0,0,0;
    waitasecond =2;
    a $(1, 4,) = 2;
# this the basic configuration model for things:
   b $(2,4,1) = 0 ;
    phi =  $$(4,,3) 4;
    c = 0 $$;
    r = 0 $(,,2/3);
    r = 3 $(,,2/3);
